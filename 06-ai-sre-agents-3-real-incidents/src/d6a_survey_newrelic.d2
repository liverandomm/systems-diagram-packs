grid-rows: 4
grid-gap: 34

c1: "Only 6.1% of respondents operate without AI incident tools" {
  class: vendor
  width: 1760
  x_lab: "New Relic 2026 Observability Forecast · vendor survey (with ETR) ·\nn=2,575 respondents · Apr–May 2026 · question not published" {class: lbl; style.font-color: "#C9D4E8"}
}

c2: "About 1 in 4 respondents run AI agents\nin production with no monitoring" {
  class: vendor
  width: 1760
  x_lab: "New Relic 2026 · vendor survey · n=2,575" {class: lbl; style.font-color: "#C9D4E8"}
}

x_note: "vendor surveys of their own respondents" {class: lbl; width: 1760; height: 50; style.font-color: "#8C9EBF"}

foot: "6.1%: PDF p.7 · 1 in 4 = 24.6% of all respondents, p.6 · p.25: all data from the 2,575-respondent survey\nsource: New Relic 2026 Observability Forecast, newrelic.com/sites/default/files/2026-09/new-relic-2026-observability-forecast-report.pdf" {class: note}

