vars: {d2-config: {pad: 24}}
grid-rows: 2
grid-gap: 30

card: "We found no independent production data\non commercial AI SRE root-cause accuracy\n(our research, Oct 2026)" {class: discrepancy; width: 1500}

foot: "amber dashed = the record disagrees or has a gap · absence of public data, not a claim about any tool" {class: note}

**.style.font-size: 36
**.style.bold: true
**.x_*.style.font-size: 28
**.x_*.style.bold: false
foot.style.font-size: 22
foot.style.bold: false
(** -> **)[*].style.font-size: 36
(** -> **)[*].style.bold: true
x_*.style.font-size: 28
x_*.style.bold: false
