classes: {
  lbl: {style: {fill: transparent; stroke: transparent; font-color: "#E6EDF7"; font: mono}}
  help: {style: {fill: "#131B30"; stroke: "#3DDB96"; stroke-width: 3; font-color: "#E6EDF7"; border-radius: 10; font: mono; bold: true}}
  hurt: {style: {fill: "#131B30"; stroke: "#FFB803"; stroke-width: 3; font-color: "#E6EDF7"; border-radius: 10; font: mono; bold: true}}
  agent: {style: {fill: "#0E1428"; stroke: "#8C9EBF"; stroke-width: 2; stroke-dash: 6; font-color: "#C9D4E8"; border-radius: 22; font: mono}}
  quote: {style: {fill: "#12192E"; stroke: "#5B7CBA"; stroke-width: 2; font-color: "#C9D4E8"; border-radius: 6; font: mono; italic: true}}
  vendor: {style: {fill: "#131B30"; stroke: "#B388FF"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  slot: {style: {fill: "#0B1020"; stroke: "#5B7CBA"; stroke-width: 2; stroke-dash: 4; font-color: "#8C9EBF"; border-radius: 8; font: mono}}
  bar: {style: {fill: "#131B30"; stroke: "#4CC9F0"; stroke-width: 3; font-color: "#E6EDF7"; font: mono; bold: true}}
}
