classes: {
  blackbox: {style: {fill: "#05070F"; stroke: "#8C9EBF"; stroke-width: 3; double-border: true; font-color: "#FFB803"; border-radius: 4; font: mono; bold: true}}
  discrepancy: {style: {fill: "#1A1606"; stroke: "#FFB803"; stroke-width: 2; stroke-dash: 5; font-color: "#FFD666"; border-radius: 10; font: mono}}
  req: {style: {stroke: "#4CC9F0"; stroke-width: 3; font-color: "#4CC9F0"}}
  req_hot: {style: {stroke: "#FF4C6E"; stroke-width: 6; font-color: "#FF4C6E"}}
  fail: {style: {stroke: "#FF4C6E"; stroke-width: 2; stroke-dash: 4; font-color: "#FF4C6E"}}
  unknown: {style: {stroke: "#8C9EBF"; stroke-width: 2; stroke-dash: 6; font-color: "#8C9EBF"}}
}
