vars: {
  d2-config: {
    pad: 40
  }
}
style.fill: "#0B1020"
classes: {
  svc: {style: {fill: "#131B30"; stroke: "#5B7CBA"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  focus: {style: {fill: "#131B30"; stroke: "#4CC9F0"; stroke-width: 3; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  ext: {style: {fill: "#12192E"; stroke: "#8C9EBF"; stroke-width: 2; stroke-dash: 4; font-color: "#8C9EBF"; border-radius: 10; font: mono}}
  warn: {style: {fill: "#131B30"; stroke: "#FFB803"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  bad: {style: {fill: "#131B30"; stroke: "#FF4C6E"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  ok: {style: {fill: "#131B30"; stroke: "#3DDB96"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  db: {shape: cylinder; style: {fill: "#131B30"; stroke: "#B388FF"; stroke-width: 2; font-color: "#E6EDF7"; font: mono}}
  person: {shape: person; style: {fill: "#131B30"; stroke: "#4CC9F0"; stroke-width: 2; font-color: "#E6EDF7"; font: mono}}
  note: {shape: text; style: {font-color: "#8C9EBF"; font: mono; font-size: 14}}
  boundary: {style: {fill: "#0E1428"; stroke: "#5B7CBA"; stroke-width: 2; stroke-dash: 5; font-color: "#4CC9F0"; border-radius: 14; font: mono}}
}

(** -> **)[*].style: {stroke: "#8C9EBF"; font-color: "#C9D4E8"}
