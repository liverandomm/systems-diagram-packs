# Timeline: three overlapping periods of impact (AWS's summary). Times PDT (ART = PDT + 4 h).
...@_style
(** -> **)[*].style: {stroke: "#5B7CBA"; font-color: "#8A9EC0"; stroke-width: 2}
direction: right
periods: "Periods of impact (PDT)" {
  class: boundary
  direction: down
  api: "EC2 API errors (EC2 section)\n23:48 → 02:25 (and elevated until 13:50)" {class: ext}
  p1: "DynamoDB\n23:48 → 02:40" {class: bad}
  p2: "EC2 launches failing\n02:25 → 10:36\n(connectivity issues until 13:50)" {class: warn}
  p3: "NLB connection errors\n05:30 → 14:09" {class: warn}
  p1 -> p2: "DNS fixed 02:25 (2 h 37 min after start)"
  p2 -> p3: "EC2 after DNS: 11 h 25 min"
}
m: "Milestones (PDT)" {
  class: boundary
  grid-columns: 3
  t1: "23:48 start"
  t2: "00:38 source identified"
  t3: "01:15 mitigations, tooling repaired"
  t4: "02:25 DNS restored"
  t5: "02:40 DynamoDB recovered"
  t6: "04:14 throttle + DWFM restarts"
  t7: "05:28 all leases"
  t8: "05:30 NLB errors begin"
  t9: "06:21 Network Manager latency"
  t10: "06:52 flapping detected"
  t11: "07:04 Lambda / Connect"
  t12: "09:36 auto failover OFF"
  t13: "10:36 propagation normal"
  t14: "10:37 launches succeed"
  t15: "11:23 throttles relaxed"
  t16: "13:50 EC2 normal"
  t17: "14:09 failover back ON"
  t18: "14:20 event ends"
}
m.*.class: svc
