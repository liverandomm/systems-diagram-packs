vars: {
  d2-config: {
    pad: 40
  }
}
style.fill: "#0B1020"
(** -> **)[*].style: {stroke: "#5B7CBA"; font-color: "#8A9EC0"; stroke-width: 2}
classes: {
  svc: {style: {fill: "#131B30"; stroke: "#5B7CBA"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  edge: {style: {fill: "#131B30"; stroke: "#4CC9F0"; stroke-width: 2; font-color: "#E6EDF7"; border-radius: 10; font: mono}}
  db: {shape: cylinder; style: {fill: "#131B30"; stroke: "#B388FF"; stroke-width: 2; font-color: "#E6EDF7"; font: mono}}
  state: {shape: circle; style: {fill: "#131B30"; stroke: "#5B7CBA"; stroke-width: 3; font-color: "#E6EDF7"; font: mono}}
}
direction: right
users: Users {class: edge}
gw: API Gateway {class: edge}
db: Database {class: db}
users -> gw
checkout: checkout {class: svc}
cart: cart {class: svc}
search: search {class: svc}
profile: profile {class: svc}
orders: orders {class: svc}
reviews: reviews {class: svc}
payments: payments {class: svc}
inventory: inventory {class: svc}
pricing: pricing {class: svc}
recs: recs {class: svc}
auth: auth {class: svc}
shipping: shipping {class: svc}
promo: promo {class: svc}
tax: tax {class: svc}
ledger: ledger {class: svc}
stock: stock {class: svc}
catalog: catalog {class: svc}
session: session {class: svc}
geo: geo {class: svc}
notify: notify {class: svc}
gw -> checkout
gw -> cart
gw -> search
gw -> profile
gw -> orders
gw -> reviews
checkout -> payments
checkout -> tax
cart -> pricing
cart -> promo
search -> recs
search -> inventory
profile -> auth
orders -> shipping
orders -> payments
reviews -> auth
payments -> ledger
inventory -> stock
pricing -> catalog
recs -> catalog
auth -> session
shipping -> geo
promo -> catalog
tax -> geo
orders -> notify
ledger -> db
stock -> db
catalog -> db
session -> db
geo -> db
notify -> db
